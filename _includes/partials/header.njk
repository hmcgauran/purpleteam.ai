<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="{{ site.title }} home">
      <img class="site-header__mark" src="/assets/brand-mark.svg" alt="" width="36" height="36" aria-hidden="true">
      <span class="site-header__brand-name">{{ site.title }}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        <li><a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Essays</a></li>
        <li><a href="/tags/" {% if page.url.startsWith('/tags') %}aria-current="page"{% endif %}>Topics</a></li>
        <li><a href="/about/" {% if page.url.startsWith('/about') %}aria-current="page"{% endif %}>About</a></li>
        <li><a href="/feed.xml">RSS</a></li>
      </ul>
    </nav>
    {# Theme toggle is rendered here in Phase 2. #}
  </div>
</header>
