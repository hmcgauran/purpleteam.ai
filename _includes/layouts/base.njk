<!DOCTYPE html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}</title>

    <meta name="description" content="{{ description or excerpt or site.description }}">

    {# Author: derive a display string the same way the post byline does,
       so the meta tag never reads "[object Object]". #}
    {% if author and author.name %}
      {% set authorName = author.name %}
    {% elif author %}
      {% set authorName = author %}
    {% else %}
      {% set authorName = site.authorName %}
    {% endif %}
    <meta name="author" content="{{ authorName }}">

    {# Open Graph #}
    {% set isArticle = tags and ('post' in tags) %}
    <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.tagline }}{% endif %}">
    <meta property="og:description" content="{{ description or excerpt or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImage }}">
    <meta property="og:image:width" content="{{ site.ogImageWidth }}">
    <meta property="og:image:height" content="{{ site.ogImageHeight }}">
    <meta property="og:locale" content="en_GB">
    {% if isArticle and date %}
      <meta property="article:published_time" content="{{ date | isoDate }}">
      <meta property="article:author" content="{{ authorName }}">
      {% for tag in tags %}{% if tag != 'post' %}<meta property="article:tag" content="{{ tag }}">{% endif %}{% endfor %}
    {% endif %}

    {# Twitter #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="{{ site.authorTwitter }}">
    <meta name="twitter:creator" content="{{ site.authorTwitter }}">
    <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}{{ site.tagline }}{% endif %}">
    <meta name="twitter:description" content="{{ description or excerpt or site.description }}">
    <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.ogImage }}">

    {# Feeds #}
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
    <link rel="sitemap" href="/sitemap.xml" type="application/xml">

    {# Typefaces (Phase 2 design system) #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap">

    {# Styles + favicon #}
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="icon" type="image/svg+xml" href="/assets/brand-mark.svg">

    {# Apply the saved theme before paint to avoid a light/dark flash. #}
    <script>
      (function () {
        try {
          var stored = localStorage.getItem('pt-theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (_) { /* localStorage blocked; keep OS preference */ }
      })();
    </script>

    {% if tags and ('post' in tags) %}
      {% include 'partials/article-schema.njk' %}
    {% endif %}
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    {% include 'partials/header.njk' %}
    <main id="main">
      {{ content | safe }}
    </main>
    {% include 'partials/footer.njk' %}
  </body>
</html>
