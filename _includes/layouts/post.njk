---
layout: layouts/base.njk
---

{% set post = page %}
{% set allPosts = collections.post %}
{% set postIndex = -1 %}
{% for p in allPosts %}
  {% if p.fileSlug == page.fileSlug %}
    {% set postIndex = loop.index0 %}
  {% endif %}
{% endfor %}
{% set prevPost = false %}
{% set nextPost = false %}
{% if postIndex > 0 %}
  {% set prevPost = allPosts[postIndex - 1] %}
{% endif %}
{% if postIndex >= 0 and postIndex < allPosts.length - 1 %}
  {% set nextPost = allPosts[postIndex + 1] %}
{% endif %}

<article class="post">
  <header class="post__header">
    <p class="post__eyebrow">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      <span class="post__sep" aria-hidden="true">·</span>
      {{ content | readingTime }}
    </p>
    <h1 class="post__title">{{ title }}</h1>
    {% if excerpt %}<p class="post__excerpt">{{ excerpt }}</p>{% endif %}
    <p class="post__byline">By <a href="/about/">{{ author or site.authorName }}</a></p>
    {% if tags %}
    <ul class="post__tags" aria-label="Topics">
      {% for tag in tags %}{% if tag != 'post' %}<li><a href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>{% endif %}{% endfor %}
    </ul>
    {% endif %}
  </header>

  <div class="post__body prose">
    {{ content | safe }}
  </div>

  <aside class="author-bio" aria-label="About the author">
    <div class="author-bio__avatar" aria-hidden="true">HM</div>
    <div>
      {% if author and author.name %}
        {% set authorName = author.name %}
      {% elif author %}
        {% set authorName = author %}
      {% else %}
        {% set authorName = site.authorName %}
      {% endif %}
      <p class="author-bio__name">{{ authorName }}</p>
      <p class="author-bio__role">{{ author.role if author and author.role else '' }}{{ ' · ' ~ author.location if author and author.location else '' }}</p>
      <p class="author-bio__copy">{{ author.shortBio if author and author.shortBio else site.description }}</p>
      <p>
        <a href="{{ author.twitter }}">Twitter</a> ·
        <a href="{{ author.linkedin }}">LinkedIn</a> ·
        <a href="{{ author.github }}">GitHub</a> ·
        <a href="mailto:{{ author.email }}">Email</a>
      </p>
    </div>
  </aside>

  {% include 'partials/newsletter-cta.njk' %}

  <nav class="post__nav" aria-label="Continue reading">
    {% if prevPost %}
      <a class="post__nav-link post__nav-link--prev" href="{{ prevPost.url }}">
        <span class="post__nav-label">Previous essay</span>
        <span class="post__nav-title">{{ prevPost.data.title }}</span>
      </a>
    {% else %}
      <span></span>
    {% endif %}
    {% if nextPost %}
      <a class="post__nav-link post__nav-link--next" href="{{ nextPost.url }}">
        <span class="post__nav-label">Next essay</span>
        <span class="post__nav-title">{{ nextPost.data.title }}</span>
      </a>
    {% endif %}
  </nav>
</article>
