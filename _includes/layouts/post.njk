---
layout: layouts/base.njk
---

{# Derive a display name from the author frontmatter. The frontmatter can
   be either a plain string ("Hugh McGauran") or an object ({name: "..."}).
   Bug 1: previously this template rendered `author or site.authorName`
   which became "[object Object]" when author was an object. #}
{% if author and author.name %}
  {% set authorName = author.name %}
{% elif author %}
  {% set authorName = author %}
{% else %}
  {% set authorName = site.authorName %}
{% endif %}

{# Get prev / next essay #}
{% set allPosts = collections.posts %}
{% set postIndex = -1 %}
{% for p in allPosts %}
  {% if p.fileSlug == page.fileSlug %}
    {% set postIndex = loop.index0 %}
  {% endif %}
{% endfor %}
{% set prevPost = false %}
{% set nextPost = false %}
{% if postIndex > 0 %}
  {% set prevPost = allPosts[postIndex - 1] %}
{% endif %}
{% if postIndex >= 0 and postIndex < allPosts.length - 1 %}
  {% set nextPost = allPosts[postIndex + 1] %}
{% endif %}

<article class="post shell">
  <header class="post__header">
    <p class="post__eyebrow">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      <span class="dot" aria-hidden="true"></span>
      <span>{{ content | readingTime }}</span>
    </p>
    <h1 class="post__title">{{ title }}</h1>
    {% if excerpt %}<p class="post__dek">{{ excerpt }}</p>{% endif %}
    <p class="post__byline">By <a href="/about/">{{ authorName }}</a></p>
    {% if tags %}
      <p class="post__chips" aria-label="Topics">
        {% for tag in tags %}{% if tag != 'post' %}
          <a class="{{ tag | chipClass }}" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
        {% endif %}{% endfor %}
      </p>
    {% endif %}
  </header>

  {# Bug 3 fix: render the dek once (above), then strip the matching first
     paragraph from the body so it doesn't show up twice. #}
  <div class="post__body prose">
    {{ content | bodyWithoutDek(excerpt) | safe }}
  </div>

  <aside class="author-bio" aria-label="About the author">
    <div class="author-bio__avatar" aria-hidden="true">{{ (authorName | first) | upper }}</div>
    <div>
      <p class="author-bio__name">{{ authorName }}</p>
      <p class="author-bio__copy">{{ authorProfile.shortBio if authorProfile and authorProfile.shortBio else site.description }}</p>
      <p>
        <a href="{{ authorProfile.twitter }}">Twitter</a>
        <a href="{{ authorProfile.linkedin }}">LinkedIn</a>
        <a href="mailto:{{ authorProfile.email }}">Email</a>
      </p>
    </div>
  </aside>

  <nav class="post__nav" aria-label="Continue reading">
    {% if prevPost %}
      <a class="post__nav-link post__nav-link--prev" href="{{ prevPost.url }}">
        <span class="post__nav-label">Previous essay</span>
        <span class="post__nav-title">{{ prevPost.data.title }}</span>
      </a>
    {% else %}<span></span>{% endif %}
    {% if nextPost %}
      <a class="post__nav-link post__nav-link--next" href="{{ nextPost.url }}">
        <span class="post__nav-label">Next essay</span>
        <span class="post__nav-title">{{ nextPost.data.title }}</span>
      </a>
    {% endif %}
  </nav>
</article>
