---
layout: layouts/base.njk
title: false
permalink: /
---

{# The convergence SVG draws itself in on load. We add the .convergence--armed
   class via inline JS below the figure. #}

{% set allPosts = collections.posts | sortDesc %}
{% set featured = false %}
{% set archive = [] %}
{% if allPosts.length > 0 %}
  {% set featured = allPosts[0] %}
  {% set archive = allPosts | dropFirst %}
{% endif %}

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__left">
      <p class="hero__eyebrow">Practitioner field notes</p>
      <h1 class="hero__title" id="hero-title">The practitioner's <em>guide</em> to purple teaming.</h1>
      <p class="hero__lede">{{ site.description }}</p>
      <p class="hero__byline">{{ site.authorName }}</p>
    </div>
    <figure class="hero__figure" aria-labelledby="hero-figure-caption">
      <svg class="convergence" viewBox="0 0 400 300" role="img" aria-labelledby="hero-figure-caption">
        <line x1="0" y1="150" x2="400" y2="150" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 6" opacity=".5"/>
        <path class="stroke-red"    d="M28 58 C 150 58, 175 138, 236 150" fill="none" stroke="var(--red)" stroke-width="3" stroke-linecap="round"/>
        <path class="stroke-blue"   d="M28 242 C 150 242, 175 162, 236 150" fill="none" stroke="var(--blue)" stroke-width="3" stroke-linecap="round"/>
        <path class="stroke-purple" d="M236 150 L 384 150" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round"/>
        <circle cx="28" cy="58" r="4.5" fill="var(--red)"/>
        <circle cx="28" cy="242" r="4.5" fill="var(--blue)"/>
        <circle class="node" cx="236" cy="150" r="9" fill="var(--accent)"/>
        <circle class="ring" cx="236" cy="150" r="15" fill="none" stroke="var(--accent)" stroke-width="1.5" opacity=".35"/>
        <text x="34" y="46"  fill="var(--red)"    font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.2">RED TEAM</text>
        <text x="34" y="266" fill="var(--blue)"   font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.2">BLUE TEAM</text>
        <text x="384" y="136" text-anchor="end" fill="var(--accent)" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.2">PURPLE</text>
      </svg>
      <figcaption id="hero-figure-caption" class="hero__figure-caption">Where offence and defence meet</figcaption>
      <script>
        // Arm the convergence figure once the page has rendered, with a
        // small delay so the eye registers the empty state first. Skipped
        // entirely when prefers-reduced-motion is set.
        (function () {
          var svg = document.querySelector('.convergence');
          if (!svg) return;
          if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            svg.classList.add('convergence--armed');
            return;
          }
          window.requestAnimationFrame(function () {
            window.setTimeout(function () { svg.classList.add('convergence--armed'); }, 80);
          });
        })();
      </script>
    </figure>
  </div>
</section>

{% if featured %}
<section class="section shell" aria-labelledby="featured-heading">
  <p class="archive__head-eyebrow" id="featured-heading">Latest essay</p>
  <article class="featured">
    <div class="featured__main">
      <p class="featured__meta">
        <time datetime="{{ featured.date | isoDate }}">{{ featured.date | readableDate }}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{{ featured.templateContent | readingTime }}</span>
        {% for tag in featured.data.tags %}{% if tag != 'post' %}
          <span class="dot" aria-hidden="true"></span>
          <span>{{ tag }}</span>
        {% endif %}{% endfor %}
      </p>
      <h2 class="featured__title"><a href="{{ featured.url }}">{{ featured.data.title }}</a></h2>
      {% if featured.data.excerpt %}<p class="featured__excerpt">{{ featured.data.excerpt }}</p>{% endif %}
      {% if featured.data.tags %}
        <p class="featured__chips">
          {% for tag in featured.data.tags %}{% if tag != 'post' %}
            <a class="{{ tag | chipClass }}" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
          {% endif %}{% endfor %}
        </p>
      {% endif %}
      <p><a class="featured__cta" href="{{ featured.url }}">Read essay</a></p>
    </div>
    <aside class="featured__aside" aria-label="The thesis">
      <p class="featured__aside-label">The thesis</p>
      <p class="featured__aside-body">{{ featured.data.excerpt or "A working note on what this essay actually argues." }}</p>
    </aside>
  </article>
</section>
{% endif %}

{% if archive.length > 0 %}
<section class="section shell" aria-labelledby="archive-heading">
  <header class="archive__head">
    <div>
      <p class="archive__head-eyebrow">Archive</p>
      <h2 class="archive__head-title">All essays, newest first</h2>
    </div>
    <div class="archive__legend" aria-label="Topic colour legend">
      <span class="archive__legend-swatch archive__legend-swatch--red">Offence</span>
      <span class="archive__legend-swatch archive__legend-swatch--blue">Defence</span>
      <span class="archive__legend-swatch archive__legend-swatch--purple">Where they meet</span>
    </div>
  </header>
  <ol class="archive__grid" role="list">
    {% for post in archive %}
      <li class="card">
        <a class="card__link" href="{{ post.url }}" aria-label="Read {{ post.data.title }}">
          <p class="card__date"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
          <h3 class="card__title">{{ post.data.title }}</h3>
          {% if post.data.excerpt %}<p class="card__excerpt">{{ post.data.excerpt }}</p>{% endif %}
        </a>
        {% if post.data.tags %}
          <p class="card__chips">
            {% for tag in post.data.tags %}{% if tag != 'post' %}
              <a class="{{ tag | chipClass }}" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
            {% endif %}{% endfor %}
          </p>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
</section>
{% endif %}
