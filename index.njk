---
layout: layouts/base.njk
title: false
permalink: /
---

{% set allPosts = collections.post | sortDesc %}
{% set featured = false %}
{% set archive = [] %}
{% if allPosts.length > 0 %}
  {% set featured = allPosts[0] %}
  {% set archive = allPosts | dropFirst %}
{% endif %}

<section class="masthead" aria-labelledby="masthead-title">
  <div class="masthead__inner">
    <div class="masthead__left">
      <p class="masthead__eyebrow">{{ site.title }}</p>
      <h1 class="masthead__title" id="masthead-title">The practitioner's <em>guide</em> to purple teaming.</h1>
      <p class="masthead__lede">{{ site.description }}</p>
    </div>
    <aside class="masthead__right">
      <p class="masthead__author">
        <strong>{{ site.authorName }}</strong>
        {{ author.role }}
      </p>
      <div class="masthead__author-links">
        <a href="{{ author.twitter }}">Twitter</a>
        <a href="{{ author.linkedin }}">LinkedIn</a>
        <a href="/about/">About</a>
      </div>
    </aside>
  </div>
</section>

{% if featured %}
<section class="container--section" aria-labelledby="featured-heading">
  <p class="section-eyebrow" id="featured-heading">Latest essay</p>
  <article class="featured-card">
    <p class="featured-card__meta">
      <time datetime="{{ featured.date | isoDate }}">{{ featured.date | readableDate }}</time>
      <span class="post__sep" aria-hidden="true">·</span>
      {{ featured.templateContent | readingTime }}
      {% if featured.data.tags %}
        {% for tag in featured.data.tags %}{% if tag != 'post' %}
          <span class="post__sep" aria-hidden="true">·</span>{{ tag }}
        {% endif %}{% endfor %}
      {% endif %}
    </p>
    <h2 class="featured-card__title">
      <a href="{{ featured.url }}">{{ featured.data.title }}</a>
    </h2>
    {% if featured.data.excerpt %}
      <p class="featured-card__excerpt">{{ featured.data.excerpt }}</p>
    {% endif %}
    <p><a class="featured-card__cta" href="{{ featured.url }}">Read essay</a></p>
  </article>
</section>
{% endif %}

{% if archive.length > 0 %}
<section class="container--section" aria-labelledby="archive-heading">
  <p class="section-eyebrow" id="archive-heading">Archive</p>
  <ol class="archive__list">
    {% for post in archive %}
      <li class="archive__item">
        <a class="archive__link" href="{{ post.url }}">
          <time class="archive__date" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
          <h3 class="archive__title">{{ post.data.title }}</h3>
          {% if post.data.excerpt %}
            <p class="archive__excerpt">{{ post.data.excerpt }}</p>
          {% endif %}
          {% if post.data.tags %}
          <p class="archive__meta-tags">
            {% for tag in post.data.tags %}{% if tag != 'post' %}<span>{{ tag }}</span>{% endif %}{% endfor %}
          </p>
          {% endif %}
        </a>
      </li>
    {% endfor %}
  </ol>
</section>
{% endif %}
